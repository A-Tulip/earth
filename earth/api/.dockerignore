# ============================================================
# 构建镜像时排除的文件（减少上下文体积 + 防止密钥/产物进镜像）
# 真实密钥通过 docker-compose 的 env_file 在运行时注入，不入镜像
# ============================================================

# 密钥与本地环境
.env
.env.*
!.env.example

# Python 虚拟环境与缓存
.venv/
venv/
__pycache__/
*.pyc

# 本地测试/校验脚本（不进生产镜像）
_test_*.py
_verify_*.py

# 仓库其它无关内容
.git/
.gitignore
README.md
Dockerfile
LICENSE