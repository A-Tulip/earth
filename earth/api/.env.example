# ============================================================
# FastAPI 后端 - 环境变量模板
#
# 配置流程（三步）：
# 1. 复制本文件为 .env：  cp .env.example .env
# 2. 按需填入下方密钥（火山引擎申请地址见各章节）
# 3. 安装依赖并启动：
#      pip install -r requirements.txt
#      uvicorn main:app --host 0.0.0.0 --port 8787 --reload
#    或从 app 目录：
#      npm run api:dev
#
# 真实密钥不提交到仓库。.env 已在 .gitignore 中。
# 也可通过部署平台环境变量注入（优先级高于 .env 文件）。
# ============================================================

# ---- 后端服务端口 ----
# 必须与 app/vite.config.ts 的 /api 代理 target 保持一致（默认 8787）
PORT=8787

# ============================================================
# 第一部分：火山引擎（豆包）密钥
# 前端 VITE_*_PROVIDER=volcengine 时需要配置以下密钥
# ============================================================

# ---- 火山方舟 LLM（豆包大模型 Responses API）----
# 申请: https://console.volcengine.com/ark
# 1. 开通方舟大模型服务
# 2. 创建 API Key（即 VOLC_ARK_API_KEY）
# 3. 选择模型（默认 doubao-seed-1-6-251015，可改为其他豆包模型或推理接入点 ID）
# 模型 ID 参考: https://www.volcengine.com/docs/82379/1159178
VOLC_ARK_API_KEY=
VOLC_ARK_MODEL=doubao-seed-1-6-251015
# （可选）高速/短答模型，用于意图解析等快速响应场景
VOLC_ARK_MODEL_FAST=

# ---- 火山引擎语音识别 ASR（豆包流式语音识别）----
# 申请: https://console.volcengine.com/speech/app
# 🔑 鉴权有两种模式（二选一，不要混配）：
#
#   模式 A（新版控制台推荐）：单一 X-Api-Key —— 在【火山引擎-语音服务-应用管理】里
#     创建"API Key"（与传统 AppID+AccessKey 是两套独立体系，不要混用）：
#       VOLC_ASR_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXX
#
#   模式 B（旧控制台）：AppID + AccessKey/AccessToken —— 传统的语音应用三件套：
#       VOLC_ASR_APP_ID= + VOLC_ASR_ACCESS_KEY=（或 VOLC_ASR_ACCESS_TOKEN=）
#
# 文档: https://www.volcengine.com/docs/6561/1354869
# Resource ID 选项:
#   豆包流式 1.0 小时版: volc.bigasr.sauc.duration
#   豆包流式 1.0 并发版: volc.bigasr.sauc.concurrent
#   豆包流式 2.0 小时版: volc.seedasr.sauc.duration
#   豆包流式 2.0 并发版: volc.seedasr.sauc.concurrent
# ---------- 模式 A（新版）----------
VOLC_ASR_API_KEY=
# ---------- 模式 B（旧版）----------
VOLC_ASR_APP_ID=
VOLC_ASR_ACCESS_TOKEN=
VOLC_ASR_ACCESS_KEY=
# ASR 鉴权模式：自动（留空）→ 有 secret_key 用 HMAC256 签名，否则用 Bearer Token
# 如需强制指定，设为 token 或 signature
VOLC_ASR_AUTH_MODE=
# 签名模式需要额外配置 Secret Key（与 Access Key 对应）
VOLC_ASR_SECRET_KEY=
VOLC_ASR_RESOURCE_ID=volc.bigasr.sauc.duration

# ---- 火山引擎语音合成 TTS（豆包语音合成）----
# 申请: https://console.volcengine.com/speech/app
# 🔑 鉴权同样有两种模式（二选一，不要混配）：
#
#   模式 A（新版控制台推荐）：单一 X-Api-Key —— 只填：
#       VOLC_TTS_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXX
#     （注意：不是 AppID 体系的 AccessKey/AccessToken，不要混用。
#       如果错误地把旧版 AccessToken 填在 VOLC_TTS_API_KEY，或
#       把新版 API Key 填在 VOLC_TTS_ACCESS_TOKEN，会触发 40200002 DeniedAccess:IllegalToken）
#
#   模式 B（旧控制台）：AppID + AccessKey/AccessToken（query-string 传参）：
#       VOLC_TTS_APP_ID= + VOLC_TTS_ACCESS_KEY=（或 VOLC_TTS_ACCESS_TOKEN=）
#
# 文档: https://www.volcengine.com/docs/6489/71999
# 发音人列表: https://www.volcengine.com/docs/6489/93478
# ---------- 模式 A（新版）----------
VOLC_TTS_API_KEY=
# ---------- 模式 B（旧版）----------
VOLC_TTS_APP_ID=
VOLC_TTS_ACCESS_TOKEN=
VOLC_TTS_ACCESS_KEY=
VOLC_TTS_VOICE_TYPE=zh_female_qingxin

# ============================================================
# 第二部分：可选 RTC（实时对话方案 A，未启用）
# 当前使用方案 B（WebSocket 流式 ASR + VAD）已满足教学场景需求
# ============================================================
# VOLC_RTC_APP_ID=
# VOLC_RTC_APP_KEY=

# ============================================================
# 常见问题（FAQ）
# ============================================================
#
# Q: 启动后前端 /api/health 返回的 llm/asr/tts 都是 false？
# A: 检查本文件对应的 VOLC_* 密钥是否已填入且非空。
#    检查 .env 文件是否在 api/ 目录下（而非 app/）。
#    重启 uvicorn 进程（--reload 模式修改 .env 不会自动重加载）。
#
# Q: 返回 PROVIDER_NOT_CONFIGURED？
# A: 对应的 VOLC_* 密钥为空。如仅需 LLM/ASR/TTS 中的某几项，
#    未配置项前端会自动降级（浏览器 Web Speech API / 关键词解析）。
#
# Q: 启动端口冲突（Address already in use :8787）？
# A: 修改 PORT= 为其他端口（如 8788），并同步修改 app/vite.config.ts
#    中 server.proxy.'/api' 的 target 端口。
#
# Q: /api/charts/generate 返回 INTERNAL（图表渲染异常）？
# A: 检查系统是否已安装中文字体（否则 matplotlib 中文标题显示为方框）：
#    macOS: brew install font-noto-sans-cjk-sc
#    Ubuntu: apt install fonts-noto-cjk
#    CentOS: yum install google-noto-sans-cjk-sc-fonts
#    不安装也能正常出图，仅中文标题自动降级为英文默认字体。
#
# Q: 与原 Node.js voice:proxy 冲突？
# A: FastAPI 版已完全覆盖原 Node voice-proxy 的所有端点（完全兼容）。
#    启用 FastAPI 后，无需再运行 npm run voice:proxy。
#    两者监听同一端口（8787），互斥启动。
