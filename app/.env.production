# 实时语音 S2S：生产环境 Vercel 无法代理 WebSocket 到后端，
# 前端直连 Railway 后端的 /ws/s2s（开发环境留空即用同源 vite 代理）。
VITE_S2S_WS_URL=wss://earth-production.up.railway.app/ws/s2s