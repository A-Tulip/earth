# ============================================================
# 生产构建环境变量（Vite 在 `vite build` 时加载，随仓库提交）
# 仅放非敏感的前端供应商开关 / 部署地址；真实密钥仍走各平台环境变量。
# ============================================================

# 后端语音 WebSocket origin：生产环境 Vercel 无法代理 WebSocket 到外部后端，
# 前端从该地址的 origin 推导同源后端 /ws/asr（流式 ASR 直连 Railway）。
# 开发环境留空即用同源 vite 代理。
VITE_S2S_WS_URL=wss://earth-production.up.railway.app/ws/s2s

# 后端 HTTP API 基址：Vercel 无法把 /api/* 转发到外部后端，前端 HTTP 请求直连 Railway。
# 开发环境留空即用同源 vite 代理（/api → localhost:8787）。
VITE_API_BASE_URL=https://earth-production.up.railway.app

# ======== 火山引擎供应商开关（生产构建必须启用，否则实时语音回退浏览器/关键词）========
# 与 app/.env.local 保持一致：实时对话走「三段式 ASR→LLM→commandBus→TTS」，
# 密钥在 api/.env，前端只声明使用哪个供应商。
VITE_LLM_PROVIDER=volcengine
VITE_TTS_PROVIDER=volcengine
VITE_ASR_PROVIDER=volcengine