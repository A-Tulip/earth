# ============================================================
# 地球探索者 - 前端环境变量模板
#
# 本文件仅用于【前端】可见的供应商开关变量（VITE_ 前缀）。
# 【服务端密钥】（火山引擎 VOLC_* 等）不在此配置，见仓库根 api/.env.example。
#
# 配置流程（两步）：
# 1. 复制本文件为 .env.local：  cp .env.example .env.local
# 2. 按需填入下方 VITE_ 开关（不填则用默认回退）
# 3. 启动前端：npm run dev
#    如需火山引擎云端能力，另起终端启动 FastAPI 后端：
#      仓库根： make api     （或 ./earth-api --reload，或 cd api && uvicorn main:app --port 8787 --reload）
#
# 真实密钥不提交到仓库。.env.local 已在 .gitignore 中。
# ============================================================

# ============================================================
# 第一部分：前端可见变量（必须带 VITE_ 前缀）
# 这些变量会被打包进前端代码，仅用于选择供应商，不包含密钥
# ============================================================

# ---- Cesium ion Token（可选，强烈推荐）----
# 用途：获取真实全球地形数据（等高线、坡度、高程分析需要）
# 不填：使用 OSM 免 token 底图 + 椭球地形（海拔恒为 0，地形分析无效果）
# 申请：https://ion.cesium.com/tokens（免费额度足够教学）
VITE_CESIUM_ION_TOKEN=

# ---- 天地图 Token（可选，推荐国内课堂使用）----
# 用途：获取中文注记版卫星/政区/地形/晕渲/等高线底图
# 不填：回退到 OSM / Esri World Imagery（英文注记）
# 申请：https://console.tianditu.gov.cn/api/key（免费申请）
VITE_TIANDITU_TOKEN=

# ---- 高德地图 Key（可选，推荐国内课堂使用）----
# 用途：获取高德卫星/路网/中文注记瓦片（amapSatellite / amapPolitical / amapRoad）
# 国内底图瓦片街景级更稳定，可放大到街道级别（zoom=19~20）
# 申请：https://console.amap.com/dev/key/app（申请"Web端(JS API)"key）
VITE_AMAP_KEY=

# ---- ASR 语音识别供应商（可选）----
# 可选值：
#   browser     浏览器 Web Speech API（默认，免配置，Chrome/Edge 中文识别质量有限）
#   volcengine  火山引擎流式 ASR（需启动 FastAPI 后端 make api + 在 api/.env 配置 VOLC_ASR_* 密钥）
# 切换方法：将下方值改为 volcengine 即可启用云端识别
VITE_ASR_PROVIDER=browser

# ---- TTS 语音合成供应商（可选）----
# 可选值：
#   browser     浏览器 speechSynthesis（默认，免配置）
#   volcengine  火山引擎 TTS（需启动 FastAPI 后端 make api + 在 api/.env 配置 VOLC_TTS_* 密钥）
VITE_TTS_PROVIDER=browser

# ---- LLM 意图理解供应商（可选）----
# 可选值：
#   keyword     本地关键词意图解析（默认，离线可用，覆盖教学常用指令）
#   volcengine  火山方舟大模型（需启动 FastAPI 后端 make api + 在 api/.env 配置 VOLC_ARK_API_KEY）
VITE_LLM_PROVIDER=keyword

# ---- 实时语音 S2S WebSocket 地址（生产部署必需）----
# 开发环境留空即可：默认 `wss://${location.host}/ws/s2s`，由 Vite 代理到 FastAPI:8787。
# 生产环境（前端在 Vercel、后端在 Railway）：Vercel 无法代理 WebSocket，
# 需设为后端公网地址，例如 `wss://earth-production.up.railway.app/ws/s2s`。
# 该项已写入 committed 的 .env.production，一般无需手动改。
VITE_S2S_WS_URL=

# ============================================================
# 第二部分：服务端密钥（火山引擎 VOLC_*）
#
# ⚠️ 这些密钥不放在本文件，必须写入仓库根 api/.env（见 api/.env.example）。
#    前端通过 /api/* 同源代理调用，密钥不暴露到浏览器。
#
# 快速开始：
#   1. cp api/.env.example api/.env
#   2. 填入所需 VOLC_* 密钥（申请地址见 api/.env.example 各章节）
#   3. cd api && uvicorn main:app --port 8787 --reload   （或仓库根 make api）
# ============================================================

# ---- 语音/LLM/图表代理服务端口（FastAPI 后端，见 api/.env.example）----
# 后端监听端口，默认 8787；开启云端能力前先在 api/.env 配置 VOLC_* 密钥。
# 完整密钥项与申请地址见仓库根 api/.env.example，此处不再重复。
PORT=8787

# ============================================================
# 第三部分：可选供应商（未启用，预留扩展）
# ============================================================

# ---- GLM（智谱）服务端代理（可选，未启用）----
# GLM_API_KEY=
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ---- 通义千问服务端代理（可选，未启用）----
# QWEN_API_KEY=
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# ---- Azure Speech 服务端代理（可选，未启用）----
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=

# ---- 本地 Studio（教师备课工具，默认关闭）----
# 开启后可通过 /studio 路由访问课程生成器
# ENABLE_STUDIO=false

# ---- 火山引擎 RTC（实时对话方案 A，可选，未启用）----
# 当前使用方案 B（WebSocket 流式 ASR + VAD）已满足教学场景需求
# 升级到方案 A（rtc_conversational_ai）需要：
#   1. 开通火山引擎 RTC 服务: https://www.volcengine.com/product/veRTC
#   2. 创建 RTC 应用，获取 AppID 和 AppKey
#   3. 前端引入 @volcengine/rtc SDK
#   4. 服务端实现 StartVoiceChat API 调用
# 文档: https://www.volcengine.com/docs/6348/1316243
# VOLC_RTC_APP_ID=
# VOLC_RTC_APP_KEY=

# ============================================================
# 常见问题（FAQ）
# ============================================================
#
# Q: 为什么按住空格没有反应？
# A: 1) 检查浏览器是否为 Chrome/Edge（需要 Web Speech API）
#    2) 检查麦克风权限是否已授予
#    3) 若配置了 VITE_ASR_PROVIDER=volcengine，检查 FastAPI 后端是否已启动（make api 或 ./earth-api --reload）
#    4) 查看 /api/health 返回（访问 http://localhost:8787/api/health）
#
# Q: 配置了火山引擎 key 但仍用浏览器识别？
# A: 1) 确认 .env.local 中 VITE_ASR_PROVIDER=volcengine（不是 browser）
#    2) 确认服务端密钥在 api/.env 或环境变量中（不是 app/.env.local）
#    3) 确认 FastAPI 后端已启动且端口 8787 可访问
#    4) 前端会先请求 /api/health，若 asr=false 则自动降级浏览器
#
# Q: 地形分析（等高线/坡度）无效果？
# A: 需要配置 VITE_CESIUM_ION_TOKEN。未配置时使用椭球回退，海拔恒为 0。
#    申请免费 token: https://ion.cesium.com/tokens
#
# Q: 语音 key 如何安全提交？
# A: 所有 VITE_ 前缀变量会被打包进前端，仅用于选择供应商。
#    真实密钥（VOLC_*）必须放在服务端 api/.env 或环境变量注入，
#    前端通过 /api/* 同源代理调用，密钥不暴露。
#
# Q: 实时对话模式（右上角塔形图标）与按住空格有何区别？
# A: - 按住空格（Push-to-Talk）：按住录音，松开提交。适合安静环境精准指令。
#    - 实时对话（Realtime Chat）：开启后持续监听，VAD 自动检测说话开始/结束，
#      检测到句末自动提交，AI 回复时说话会自动打断（barge-in）。
#      适合自然对话式教学，无需按键。
#    两种模式互斥，启用实时对话时按住空格失效。
#    降级链：流式 ASR → 浏览器 Web Speech API → 关闭实时对话回退 Push-to-Talk。
