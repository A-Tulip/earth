# ============================================================
# 地球探索者 - 环境变量模板
#
# 配置流程（三步）：
# 1. 复制本文件为 .env.local：  cp .env.example .env.local
# 2. 按需填入下方密钥（火山引擎申请地址见各章节）
# 3. 启动前端：npm run dev
#    如启用火山引擎语音，另起终端：npm run voice:proxy
#
# 真实密钥不提交到仓库。.env.local 已在 .gitignore 中。
# ============================================================

# ============================================================
# 第一部分：前端可见变量（必须带 VITE_ 前缀）
# 这些变量会被打包进前端代码，仅用于选择供应商，不包含密钥
# ============================================================

# ---- Cesium ion Token（可选，强烈推荐）----
# 用途：获取真实全球地形数据（等高线、坡度、高程分析需要）
# 不填：使用 OSM 免 token 底图 + 椭球地形（海拔恒为 0，地形分析无效果）
# 申请：https://ion.cesium.com/tokens（免费额度足够教学）
VITE_CESIUM_ION_TOKEN=

# ---- ASR 语音识别供应商（可选）----
# 可选值：
#   browser     浏览器 Web Speech API（默认，免配置，Chrome/Edge 中文识别质量有限）
#   volcengine  火山引擎流式 ASR（需启动 npm run voice:proxy + 配置下方 VOLC_ASR_* 密钥）
# 切换方法：将下方值改为 volcengine 即可启用云端识别
VITE_ASR_PROVIDER=browser

# ---- TTS 语音合成供应商（可选）----
# 可选值：
#   browser     浏览器 speechSynthesis（默认，免配置）
#   volcengine  火山引擎 TTS（需启动 npm run voice:proxy + 配置下方 VOLC_TTS_* 密钥）
VITE_TTS_PROVIDER=browser

# ---- LLM 意图理解供应商（可选）----
# 可选值：
#   keyword     本地关键词意图解析（默认，离线可用，覆盖教学常用指令）
#   volcengine  火山方舟大模型（需启动 npm run voice:proxy + 配置下方 VOLC_ARK_API_KEY）
VITE_LLM_PROVIDER=keyword

# ============================================================
# 第二部分：服务端密钥（不带 VITE_ 前缀，不进入前端）
#
# 重要：这些变量必须放在服务端环境，不能放在 .env.local（会被前端读取）
# 正确做法：复制到 app/server/.env 或通过部署平台环境变量注入
#
# 启动方式：
#   方式 A（推荐）：在 app/server/ 目录创建 .env 文件
#     cd app/server && cp ../.env.example .env && 填入密钥
#     npm run voice:proxy  （自动读取 server/.env）
#
#   方式 B：在启动命令前注入环境变量
#     VOLC_ARK_API_KEY=sk-xxx npm run voice:proxy
# ============================================================

# ---- 语音/LLM 代理服务端口 ----
PORT=8787

# ---- 火山方舟 LLM（豆包大模型，OpenAI 兼容）----
# 申请: https://console.volcengine.com/ark
# 1. 开通方舟大模型服务
# 2. 创建 API Key（即下方 VOLC_ARK_API_KEY）
# 3. 选择模型（默认 doubao-seed-1.6-250615，可改为其他豆包模型）
# 模型 ID 参考: https://www.volcengine.com/docs/82379/1159178
VOLC_ARK_API_KEY=
VOLC_ARK_MODEL=doubao-seed-1.6-250615

# ---- 火山引擎语音识别 ASR（豆包流式语音识别）----
# 申请: https://console.volcengine.com/speech/app
# 1. 创建语音应用，获取 APP_ID 和 ACCESS_KEY
# 2. 开通"流式语音识别"服务
# 3. 选择 Resource ID（按时长或并发计费）
# 文档: https://www.volcengine.com/docs/6561/1354869
# Resource ID 选项:
#   豆包流式 1.0 小时版: volc.bigasr.sauc.duration
#   豆包流式 1.0 并发版: volc.bigasr.sauc.concurrent
#   豆包流式 2.0 小时版: volc.seedasr.sauc.duration
#   豆包流式 2.0 并发版: volc.seedasr.sauc.concurrent
VOLC_ASR_APP_ID=
VOLC_ASR_ACCESS_KEY=
VOLC_ASR_RESOURCE_ID=volc.bigasr.sauc.duration

# ---- 火山引擎语音合成 TTS（豆包语音合成）----
# 申请: https://console.volcengine.com/speech/app
# 1. 在同一语音应用中开通"语音合成"服务
# 2. 选择发音人（zh_female_qingxin 为清新女声）
# 文档: https://www.volcengine.com/docs/6489/71999
# 发音人列表: https://www.volcengine.com/docs/6489/93478
VOLC_TTS_APP_ID=
VOLC_TTS_ACCESS_KEY=
VOLC_TTS_VOICE_TYPE=zh_female_qingxin

# ============================================================
# 第三部分：可选供应商（未启用，预留扩展）
# ============================================================

# ---- GLM（智谱）服务端代理（可选，未启用）----
# GLM_API_KEY=
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ---- 通义千问服务端代理（可选，未启用）----
# QWEN_API_KEY=
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# ---- Azure Speech 服务端代理（可选，未启用）----
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=

# ---- 本地 Studio（教师备课工具，默认关闭）----
# 开启后可通过 /studio 路由访问课程生成器
# ENABLE_STUDIO=false

# ---- 火山引擎 RTC（实时对话方案 A，可选，未启用）----
# 当前使用方案 B（WebSocket 流式 ASR + VAD）已满足教学场景需求
# 升级到方案 A（rtc_conversational_ai）需要：
#   1. 开通火山引擎 RTC 服务: https://www.volcengine.com/product/veRTC
#   2. 创建 RTC 应用，获取 AppID 和 AppKey
#   3. 前端引入 @volcengine/rtc SDK
#   4. 服务端实现 StartVoiceChat API 调用
# 文档: https://www.volcengine.com/docs/6348/1316243
# VOLC_RTC_APP_ID=
# VOLC_RTC_APP_KEY=

# ============================================================
# 常见问题（FAQ）
# ============================================================
#
# Q: 为什么按住空格没有反应？
# A: 1) 检查浏览器是否为 Chrome/Edge（需要 Web Speech API）
#    2) 检查麦克风权限是否已授予
#    3) 若配置了 VITE_ASR_PROVIDER=volcengine，检查 npm run voice:proxy 是否已启动
#    4) 查看 /api/health 返回（访问 http://localhost:8787/api/health）
#
# Q: 配置了火山引擎 key 但仍用浏览器识别？
# A: 1) 确认 .env.local 中 VITE_ASR_PROVIDER=volcengine（不是 browser）
#    2) 确认服务端密钥在 app/server/.env 或环境变量中（不是 .env.local）
#    3) 确认 npm run voice:proxy 已启动且端口 8787 可访问
#    4) 前端会先请求 /api/health，若 asr=false 则自动降级浏览器
#
# Q: 地形分析（等高线/坡度）无效果？
# A: 需要配置 VITE_CESIUM_ION_TOKEN。未配置时使用椭球回退，海拔恒为 0。
#    申请免费 token: https://ion.cesium.com/tokens
#
# Q: 语音 key 如何安全提交？
# A: 所有 VITE_ 前缀变量会被打包进前端，仅用于选择供应商。
#    真实密钥（VOLC_*）必须放在服务端，通过 app/server/.env 或环境变量注入，
#    前端通过 /api/* 同源代理调用，密钥不暴露。
#
# Q: 实时对话模式（右上角塔形图标）与按住空格有何区别？
# A: - 按住空格（Push-to-Talk）：按住录音，松开提交。适合安静环境精准指令。
#    - 实时对话（Realtime Chat）：开启后持续监听，VAD 自动检测说话开始/结束，
#      检测到句末自动提交，AI 回复时说话会自动打断（barge-in）。
#      适合自然对话式教学，无需按键。
#    两种模式互斥，启用实时对话时按住空格失效。
#    降级链：流式 ASR → 浏览器 Web Speech API → 关闭实时对话回退 Push-to-Talk。
